includes:
  - phpstan-baseline.neon

parameters:
  level: 5
  phpVersion: 70400
  treatPhpDocTypesAsCertain: false

  paths:
    - avarda-checkout-for-woocommerce.php
    - classes
    - includes
    - templates

  excludePaths:
    - node_modules (?)
    - assets

  scanFiles:
    - phpstan-stubs.php

  scanDirectories:
    - vendor/php-stubs
    - dependencies
    - kernl-update-checker

  bootstrapFiles:
    - phpstan-bootstrap.php
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
    - vendor/php-stubs/woocommerce-subscriptions-stubs/woocommerce-subscriptions-stubs.php

  dynamicConstantNames:
    - AVARDA_CHECKOUT_VERSION
    - AVARDA_CHECKOUT_URL
    - AVARDA_CHECKOUT_PATH
    - AVARDA_CHECKOUT_LIVE_ENV
    - AVARDA_CHECKOUT_TEST_ENV
